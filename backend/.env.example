# Copy this file to `.env` (same folder as manage.py) and fill in real values.
# `.env` itself is already covered by .gitignore — never commit it.

# Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=paste-a-freshly-generated-secret-key-here

# True for local development, False once this runs on a real server
DJANGO_DEBUG=True

# Comma-separated. For local dev, localhost is enough.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call this API.
# Local dev default matches `npm run dev` (Vite).
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
